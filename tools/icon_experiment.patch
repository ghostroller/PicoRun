+//! Evaluation only: visible icons, one blocking worker, latest request, bounded LRU.
+use super::{ffi::*, wide};
+use std::{
+    cell::{Cell, RefCell},
+    io,
+    path::PathBuf,
+    ptr::null_mut,
+    sync::{
+        atomic::{AtomicBool, Ordering},
+        mpsc::{self, Receiver},
+        Arc, Condvar, Mutex,
+    },
+    thread::{self, JoinHandle},
+    time::Instant,
+};
+
+pub const READY: u32 = 0x8005;
+pub const CAPACITY: usize = 48;
+pub struct Icon(usize, bool);
+impl Icon {
+    pub fn handle(&self) -> Handle {
+        self.0 as Handle
+    }
+}
+impl Drop for Icon {
+    fn drop(&mut self) {
+        unsafe {
+            DestroyIcon(self.handle());
+        }
+    }
+}
+#[repr(C)]
+struct FileInfo {
+    icon: Handle,
+    index: i32,
+    attributes: u32,
+    display: [u16; 260],
+    kind: [u16; 80],
+}
+#[link(name = "shell32")]
+unsafe extern "system" {
+    fn ExtractIconExW(
+        path: *const u16,
+        index: i32,
+        large: *mut Handle,
+        small: *mut Handle,
+        count: u32,
+    ) -> u32;
+    fn SHGetFileInfoW(
+        path: *const u16,
+        attributes: u32,
+        info: *mut FileInfo,
+        size: u32,
+        flags: u32,
+    ) -> usize;
+}
+#[link(name = "user32")]
+unsafe extern "system" {
+    fn LoadIconW(instance: Handle, name: *const u16) -> Handle;
+    fn CopyIcon(icon: Handle) -> Handle;
+}
+fn generic() -> Option<Arc<Icon>> {
+    let icon = unsafe { CopyIcon(LoadIconW(null_mut(), 32512usize as *const u16)) };
+    if icon.is_null() {
+        None
+    } else {
+        Some(Arc::new(Icon(icon as usize, true)))
+    }
+}
+#[link(name = "kernel32")]
+unsafe extern "system" {
+    fn ExpandEnvironmentStringsW(source: *const u16, output: *mut u16, size: u32) -> u32;
+}
+fn direct(path: &std::path::Path, resource: &mut [u16], expanded: &mut [u16]) -> Option<Arc<Icon>> {
+    let path_text = wide(path);
+    if path_text.len() > resource.len() {
+        return None;
+    }
+    resource[..path_text.len()].copy_from_slice(&path_text);
+    let mut index = 0;
+    if path
+        .extension()
+        .is_some_and(|e| e.eq_ignore_ascii_case("lnk"))
+    {
+        let (link, persist) = super::discovery::shell_link().ok()?;
+        resource[0] = 0;
+        unsafe {
+            let load: unsafe extern "system" fn(*mut std::ffi::c_void, *const u16, u32) -> i32 =
+                std::mem::transmute(persist.method(5));
+            if load(persist.0, wide(path).as_ptr(), 0) < 0 {
+                return None;
+            }
+            let location: unsafe extern "system" fn(
+                *mut std::ffi::c_void,
+                *mut u16,
+                i32,
+                *mut i32,
+            ) -> i32 = std::mem::transmute(link.method(16));
+            if location(
+                link.0,
+                resource.as_mut_ptr(),
+                resource.len() as i32,
+                &mut index,
+            ) < 0
+            {
+                return None;
+            }
+            if resource[0] == 0 {
+                let target: unsafe extern "system" fn(
+                    *mut std::ffi::c_void,
+                    *mut u16,
+                    i32,
+                    *mut std::ffi::c_void,
+                    u32,
+                ) -> i32 = std::mem::transmute(link.method(3));
+                if target(
+                    link.0,
+                    resource.as_mut_ptr(),
+                    resource.len() as i32,
+                    null_mut(),
+                    4,
+                ) < 0
+                {
+                    return None;
+                }
+                index = 0;
+            }
+        }
+    }
+    let length = unsafe {
+        ExpandEnvironmentStringsW(
+            resource.as_ptr(),
+            expanded.as_mut_ptr(),
+            expanded.len() as u32,
+        )
+    };
+    if length == 0 || length as usize > expanded.len() {
+        return None;
+    }
+    let mut icon = null_mut();
+    let count = unsafe { ExtractIconExW(expanded.as_ptr(), index, &mut icon, null_mut(), 1) };
+    if icon.is_null() {
+        None
+    } else if count == 1 {
+        Some(Arc::new(Icon(icon as usize, false)))
+    } else {
+        unsafe {
+            DestroyIcon(icon);
+        };
+        None
+    }
+}
+fn load(path: &std::path::Path) -> Option<Arc<Icon>> {
+    let mut info = FileInfo {
+        icon: null_mut(),
+        index: 0,
+        attributes: 0,
+        display: [0; 260],
+        kind: [0; 80],
+    };
+    // COM initialized on worker. Returned HICON is owned and kept alive by Arc during paint.
+    let okay = unsafe {
+        SHGetFileInfoW(
+            wide(path).as_ptr(),
+            0,
+            &mut info,
+            std::mem::size_of::<FileInfo>() as u32,
+            0x100,
+        )
+    };
+    if okay == 0 || info.icon.is_null() {
+        None
+    } else {
+        Some(Arc::new(Icon(info.icon as usize, false)))
+    }
+}
+type Request = (u64, Vec<PathBuf>);
+struct Shared {
+    latest: Mutex<Option<Request>>,
+    wake: Condvar,
+    stop: AtomicBool,
+}
+pub struct Completed {
+    pub fallbacks: usize,
+    pub generation: u64,
+    pub icons: Vec<Option<Arc<Icon>>>,
+    pub hits: usize,
+    pub misses: usize,
+    pub cache: usize,
+    pub max_load_us: usize,
+    pub total_load_us: usize,
+}
+struct Worker {
+    shared: Arc<Shared>,
+    rx: Option<Receiver<Completed>>,
+    join: Option<JoinHandle<()>>,
+}
+impl Worker {
+    fn new(hwnd: Hwnd, direct_icons: bool) -> io::Result<Self> {
+        let shared = Arc::new(Shared {
+            latest: Mutex::new(None),
+            wake: Condvar::new(),
+            stop: AtomicBool::new(false),
+        });
+        let work = Arc::clone(&shared);
+        let (tx, rx) = mpsc::sync_channel(1);
+        let owner = hwnd as usize;
+        let join = thread::Builder::new()
+            .name("icon-eval".into())
+            .spawn(move || {
+                if unsafe { CoInitializeEx(null_mut(), 2) } < 0 {
+                    return;
+                }
+                let mut cache: Vec<(PathBuf, Option<Arc<Icon>>)> = Vec::with_capacity(CAPACITY);
+                let mut resource = if direct_icons {
+                    vec![0u16; 32768]
+                } else {
+                    Vec::new()
+                };
+                let mut expanded = if direct_icons {
+                    vec![0u16; 32768]
+                } else {
+                    Vec::new()
+                };
+                let (mut hits, mut misses, mut max_load_us, mut total_load_us) = (0, 0, 0, 0);
+                let mut fallbacks = 0;
+                loop {
+                    let request = {
+                        let mut next = work.latest.lock().unwrap();
+                        while next.is_none() && !work.stop.load(Ordering::Acquire) {
+                            next = work.wake.wait(next).unwrap();
+                        }
+                        if work.stop.load(Ordering::Acquire) {
+                            break;
+                        }
+                        next.take().unwrap()
+                    };
+                    let (generation, paths) = request;
+                    let mut icons = Vec::with_capacity(paths.len());
+                    for path in paths {
+                        if work.stop.load(Ordering::Acquire)
+                            || work.latest.lock().unwrap().is_some()
+                        {
+                            break;
+                        }
+                        let icon = if let Some(index) = cache.iter().position(|(p, _)| p == &path) {
+                            hits += 1;
+                            let cached = cache.remove(index);
+                            let value = cached.1.clone();
+                            cache.push(cached);
+                            value
+                        } else {
+                            misses += 1;
+                            let start = Instant::now();
+                            let value = if direct_icons {
+                                direct(&path, &mut resource, &mut expanded).or_else(generic)
+                            } else {
+                                load(&path)
+                            };
+                            fallbacks += usize::from(value.as_ref().is_some_and(|icon| icon.1));
+                            let elapsed = start.elapsed().as_micros() as usize;
+                            total_load_us += elapsed;
+                            max_load_us = max_load_us.max(elapsed);
+                            if cache.len() == CAPACITY {
+                                cache.remove(0);
+                            }
+                            cache.push((path, value.clone()));
+                            value
+                        };
+                        icons.push(icon);
+                    }
+                    let result = Completed {
+                        fallbacks,
+                        generation,
+                        icons,
+                        hits,
+                        misses,
+                        cache: cache.len(),
+                        max_load_us,
+                        total_load_us,
+                    };
+                    if tx.send(result).is_err() {
+                        break;
+                    }
+                    // No shared lock is held while calling Win32. UI consumes only matching generation.
+                    unsafe {
+                        PostMessageW(owner as Hwnd, READY, 0, 0);
+                    }
+                }
+                drop(cache); // Destroy owned icons before uninitializing worker COM.
+                unsafe {
+                    CoUninitialize();
+                }
+            })?;
+        Ok(Self {
+            shared,
+            rx: Some(rx),
+            join: Some(join),
+        })
+    }
+}
+impl Drop for Worker {
+    fn drop(&mut self) {
+        self.rx.take(); // Unblock a sender before joining, including shutdown with an unread result.
+        self.shared.stop.store(true, Ordering::Release);
+        self.shared.wake.notify_one();
+        if let Some(join) = self.join.take() {
+            let _ = join.join();
+        }
+    }
+}
+pub struct Session {
+    pub fallbacks: Cell<usize>,
+    hwnd: Hwnd,
+    direct_icons: bool,
+    paths: RefCell<Vec<PathBuf>>,
+    worker: RefCell<Option<Worker>>,
+    pub requested: Cell<u64>,
+    pub completed: Cell<u64>,
+    pub hits: Cell<usize>,
+    pub misses: Cell<usize>,
+    pub cache: Cell<usize>,
+    pub max_load_us: Cell<usize>,
+    pub total_load_us: Cell<usize>,
+}
+impl Session {
+    pub fn new(hwnd: Hwnd, direct_icons: bool) -> Self {
+        Self {
+            fallbacks: Cell::new(0),
+            hwnd,
+            direct_icons,
+            paths: RefCell::new(Vec::new()),
+            worker: RefCell::new(None),
+            requested: Cell::new(0),
+            completed: Cell::new(0),
+            hits: Cell::new(0),
+            misses: Cell::new(0),
+            cache: Cell::new(0),
+            max_load_us: Cell::new(0),
+            total_load_us: Cell::new(0),
+        }
+    }
+    pub fn request(&self, paths: Vec<PathBuf>) -> io::Result<bool> {
+        if paths == *self.paths.borrow() && self.requested.get() != 0 {
+            return Ok(false);
+        }
+        *self.paths.borrow_mut() = paths.clone();
+        let mut worker = self.worker.borrow_mut();
+        if worker.is_none() {
+            *worker = Some(Worker::new(self.hwnd, self.direct_icons)?);
+        }
+        let worker = worker.as_ref().unwrap();
+        let generation = self.requested.get() + 1;
+        self.requested.set(generation);
+        *worker.shared.latest.lock().unwrap() = Some((generation, paths));
+        worker.shared.wake.notify_one();
+        Ok(true)
+    }
+    pub fn receive(&self) -> Option<Completed> {
+        let worker = self.worker.borrow();
+        let rx = worker.as_ref()?.rx.as_ref()?;
+        let mut latest = None;
+        while let Ok(result) = rx.try_recv() {
+            self.fallbacks.set(result.fallbacks);
+            self.hits.set(result.hits);
+            self.misses.set(result.misses);
+            self.cache.set(result.cache);
+            self.max_load_us.set(result.max_load_us);
+            self.total_load_us.set(result.total_load_us);
+            if result.generation == self.requested.get() {
+                self.completed.set(result.generation);
+                latest = Some(result);
+            }
+        }
+        latest
+    }
+}
